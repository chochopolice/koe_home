<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- 上: 時計と日付 (長押しで家族向けメニュー) -->
    <LinearLayout
        android:id="@+id/clockArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="M月d日（E）"
            android:format24Hour="M月d日（E）"
            android:textColor="@color/sub"
            android:textSize="24sp" />

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="H:mm"
            android:format24Hour="H:mm"
            android:textColor="@color/ink"
            android:textSize="56sp"
            android:textStyle="bold" />
    </LinearLayout>

    <Button
        android:id="@+id/exit"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="4dp"
        android:backgroundTint="@color/no"
        android:text="✕ とじて、いつもの画面へ"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="22sp" />

    <!-- 中央: ホーム(連絡先ボタン) と 写真 を切り替える -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/homePanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <Button
                    android:id="@+id/openPhotos"
                    android:layout_width="match_parent"
                    android:layout_height="88dp"
                    android:layout_marginBottom="12dp"
                    android:backgroundTint="@color/photo"
                    android:text="写真を見る"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="28sp" />

                <TextView
                    android:id="@+id/listHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="8dp"
                    android:textColor="@color/sub"
                    android:textSize="22sp" />

                <LinearLayout
                    android:id="@+id/contactList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:id="@+id/photoPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#000000"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/photoInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="6dp"
                android:textColor="@color/white"
                android:textSize="20sp" />

            <ImageView
                android:id="@+id/photo"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:contentDescription="写真"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/photoPrev"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:text="◀ 前"
                    android:textSize="24sp" />

                <Button
                    android:id="@+id/photoClose"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:text="とじる"
                    android:textSize="24sp" />

                <Button
                    android:id="@+id/photoNext"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:text="次 ▶"
                    android:textSize="24sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Web検索の結果 -->
        <LinearLayout
            android:id="@+id/webPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <WebView
                android:id="@+id/web"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/webUp"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:text="▲ 上"
                    android:textSize="22sp" />

                <Button
                    android:id="@+id/webDown"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:text="▼ 下"
                    android:textSize="22sp" />

                <Button
                    android:id="@+id/webBack"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:text="◀ 前"
                    android:textSize="22sp" />

                <Button
                    android:id="@+id/webClose"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:text="とじる"
                    android:textSize="22sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- 下: メッセージ・聞こえた言葉・はい/いいえ・話すボタン -->
    <TextView
        android:id="@+id/message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:minLines="2"
        android:textColor="@color/ink"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/heard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="2"
        android:textColor="@color/sub"
        android:textSize="20sp" />

    <LinearLayout
        android:id="@+id/confirmRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button
            android:id="@+id/yes"
            android:layout_width="0dp"
            android:layout_height="96dp"
            android:layout_weight="1"
            android:backgroundTint="@color/yes"
            android:text="はい"
            android:textColor="@color/white"
            android:textSize="34sp" />

        <Button
            android:id="@+id/no"
            android:layout_width="0dp"
            android:layout_height="96dp"
            android:layout_weight="1"
            android:backgroundTint="@color/no"
            android:text="いいえ"
            android:textColor="@color/white"
            android:textSize="34sp" />
    </LinearLayout>

    <Button
        android:id="@+id/talk"
        android:layout_width="match_parent"
        android:layout_height="132dp"
        android:layout_marginTop="8dp"
        android:backgroundTint="@color/talk"
        android:text="🎤 話す"
        android:textColor="@color/white"
        android:textSize="40sp" />
</LinearLayout>
